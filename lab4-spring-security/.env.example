# Reference only: Spring Boot reads these values from the current PowerShell environment.
DB_URL=jdbc:mysql://localhost:3306/lab4_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password
SERVER_PORT=8080
JWT_SECRET_BASE64=generate-a-private-32-byte-base64-key
JWT_EXPIRATION_SECONDS=3600
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=lab-admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=use-a-private-local-password
